<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <appender name="ERRORES" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>logs/errores.txt</file>
    <rollingPolicy class="com.prueba.factura.config.PoliticaLogDiario">
      <fileNamePattern>logs/errores.%d{yyyy-MM-dd}.txt</fileNamePattern>
    </rollingPolicy>
    <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
      <level>ERROR</level>
    </filter>
    <encoder>
      <charset>UTF-8</charset>
      <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level %logger{40} - %msg%n%ex</pattern>
    </encoder>
  </appender>
  <root level="ERROR">
    <appender-ref ref="ERRORES"/>
  </root>
</configuration>
